<view class="login-page">
  <view class="login-bg login-bg--blue" />
  <view class="login-bg login-bg--green" />

  <view class="login-card">
    <view class="login-card__logo">
      <t-icon name="logo-wechat-stroke" size="64rpx" />
    </view>
    <text class="login-card__eyebrow">Wechat Verification</text>
    <text class="login-card__title">登录后继续使用心理健康支持小程序</text>
    <text class="login-card__desc">
      登录用于保存你的测评报告、情绪记录和辅导预约。当前版本使用微信会话凭证做本地验证，正式上线时可接入后端换取 openid。
    </text>

    <view class="feature-list">
      <view class="feature-item">
        <t-icon name="logo-wechat-stroke" size="34rpx" />
        <text>微信会话校验</text>
      </view>
      <view class="feature-item">
        <t-icon name="user" size="34rpx" />
        <text>保存个人测评档案</text>
      </view>
      <view class="feature-item">
        <t-icon name="view-list" size="34rpx" />
        <text>持续跟踪压力趋势</text>
      </view>
    </view>

    <checkbox-group class="agreement" bindchange="onAgreeChange">
      <label class="agreement__label">
        <checkbox value="agree" checked="{{agreed}}" color="#1a73e8" />
        <text>我同意使用微信登录验证，并了解心理测评结果仅作支持参考。</text>
      </label>
    </checkbox-group>

    <t-button
      class="login-button"
      theme="primary"
      size="large"
      block
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="handleWechatLogin"
    >
      微信授权登录
    </t-button>
  </view>
</view>
