.search-page {
  box-sizing: border-box;
  width: 100vw;
  min-height: 100vh;
  padding: 0 24rpx 60rpx;
  background: #f8fafd;
}

.search-input-shell {
  padding: 18rpx 0 8rpx;
}

.search-page .t-class__input-container {
  border-radius: 999rpx !important;
  background: rgba(255, 255, 255, 0.96) !important;
  border: 1rpx solid rgba(211, 227, 253, 0.92);
  box-shadow: 0 8rpx 24rpx rgba(26, 115, 232, 0.08);
}

.search-page .t-search__input {
  font-size: 28rpx !important;
  color: #1f1f1f !important;
}

.search-intro {
  margin-top: 12rpx;
  padding: 8rpx 8rpx 0;
}

.search-intro__title {
  display: block;
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #1f1f1f;
}

.search-intro__desc {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(31, 31, 31, 0.56);
}

.search-panel {
  margin-top: 28rpx;
  padding: 28rpx 24rpx 16rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 32rpx rgba(60, 64, 67, 0.08);
}

.search-panel--discover {
  margin-top: 20rpx;
}

.search-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.search-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f1f1f;
}

.search-clear {
  color: rgba(31, 31, 31, 0.48);
}

.search-content {
  overflow: hidden;
  display: flex;
  flex-flow: row wrap;
  justify-content: flex-start;
  align-items: flex-start;
  margin-top: 20rpx;
}

.search-item {
  margin-right: 20rpx;
  margin-bottom: 20rpx;
}

.hover-history-item {
  opacity: 0.88;
  transform: translateY(2rpx);
}

.search-page .search-item .popular-item,
.search-page .search-item .history-item {
  min-height: 56rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
}

.search-page .search-item .popular-item {
  background: #eef3fd;
}

.search-page .search-item .history-item {
  background: #edf2f7;
}