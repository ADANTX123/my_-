<nav nav-type="search" />

<scroll-view class="home-shell" scroll-y>
  <view class="home-hero">
    <view class="home-hero__copy">
      <text class="home-hero__eyebrow">Medical Student Support</text>
      <text class="home-hero__title">医学生心理健康支持小程序</text>
      <text class="home-hero__desc">围绕“筛查 → 评估 → 干预 → 跟踪”构建闭环，把问卷数据、量表评估和持续档案合到一个入口。</text>
    </view>
    <view class="home-hero__badge" bindtap="goResult">
      <text>{{heroBadgeValue}}</text>
      <text>{{heroBadgeLabel}}</text>
    </view>
  </view>

  <view class="home-stats">
    <view wx:for="{{stats}}" wx:key="label" class="home-stats__item">
      <text class="home-stats__value">{{item.value}}</text>
      <text class="home-stats__label">{{item.label}}</text>
    </view>
  </view>

  <view class="home-actions">
    <view
      wx:for="{{quickActions}}"
      wx:key="value"
      class="home-action"
      data-value="{{item.value}}"
      bindtap="handleQuickAction"
    >
      <t-icon name="{{item.icon}}" size="34rpx" />
      <view>
        <text>{{item.label}}</text>
        <text>{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="home-section">
    <view class="home-section__header">
      <text class="home-section__title">产品闭环</text>
      <text class="home-section__meta">需求图里的核心流程已经拆成四个主功能模块</text>
    </view>
    <view class="loop-grid">
      <view wx:for="{{coreLoop}}" wx:key="label" class="loop-card">
        <text class="loop-card__index">{{index + 1}}</text>
        <text class="loop-card__title">{{item.label}}</text>
        <text class="loop-card__desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="home-section">
    <view class="home-section__header">
      <text class="home-section__title">问卷压力结构</text>
      <text class="home-section__meta">来自 199 份医学生压力与心理健康需求调研</text>
    </view>
    <view class="pressure-grid">
      <view wx:for="{{pressureOverview}}" wx:key="label" class="pressure-card pressure-card--{{item.tone}}">
        <text>{{item.percent}}%</text>
        <text>{{item.label}}</text>
        <text>{{item.value}} 人</text>
      </view>
    </view>
  </view>

  <view class="home-section">
    <view class="home-section__header">
      <text class="home-section__title">高压维度 Top 5</text>
      <text class="home-section__meta">后续测评会把个人维度和群体维度进行对照</text>
    </view>
    <view class="dimension-list">
      <view wx:for="{{topDimensions}}" wx:key="label" class="dimension-item">
        <view class="dimension-item__top">
          <text>{{item.label}}</text>
          <text>{{item.value}}</text>
        </view>
        <view class="dimension-item__track">
          <view class="dimension-item__bar" style="width: {{item.value * 20}}%;" />
        </view>
        <text class="dimension-item__desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="home-section home-section--last">
    <view class="home-section__header">
      <text class="home-section__title">用户最需要什么</text>
      <text class="home-section__meta">功能优先级来自问卷选择频次</text>
    </view>
    <view class="feature-list">
      <view wx:for="{{topFeatures}}" wx:key="label" class="feature-chip">
        <text>{{item.label}}</text>
        <text>{{item.value}}</text>
      </view>
    </view>
  </view>
</scroll-view>
