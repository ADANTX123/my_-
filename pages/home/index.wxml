<nav nav-type="search" />

<scroll-view class="home-shell" scroll-y>
  <view class="home-hero">
    <view class="home-hero__copy">
      <text class="home-hero__eyebrow">Google-style workspace</text>
      <text class="home-hero__title">Priority inbox for every important update</text>
      <text class="home-hero__desc">A calmer dashboard for unread items, saved resources and quick actions.</text>
    </view>

    <view class="home-stats">
      <view wx:for="{{workspaceStats}}" wx:key="label" class="home-stats__item">
        <text class="home-stats__value">{{item.value}}</text>
        <text class="home-stats__label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="home-actions">
    <view
      wx:for="{{quickActions}}"
      wx:key="value"
      class="home-action"
      data-value="{{item.value}}"
      bindtap="handleQuickAction"
    >
      <t-icon name="{{item.icon}}" size="34rpx" />
      <text>{{item.label}}</text>
    </view>
  </view>

  <view class="home-section">
    <view class="home-section__header">
      <text class="home-section__title">Highlights</text>
      <text class="home-section__meta">What this Gmail-style pass changes first</text>
    </view>
    <swiper class="home-highlight-swiper" circular indicator-dots autoplay interval="4200" duration="500">
      <swiper-item wx:for="{{workspaceHighlights}}" wx:key="title">
        <view class="highlight-card">
          <text class="highlight-card__title">{{item.title}}</text>
          <text class="highlight-card__desc">{{item.desc}}</text>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <view class="home-section">
    <view class="home-section__header">
      <text class="home-section__title">Priority stack</text>
      <text class="home-section__meta">Curated cards that feel closer to a focused inbox than a generic feed</text>
    </view>
    <scroll-view class="home-card-row" scroll-x enable-flex show-scrollbar="{{false}}">
      <card wx:for="{{focusCardInfo}}" wx:key="index" desc="{{item.desc}}" url="{{item.url}}" tags="{{item.tags}}" />
    </scroll-view>
  </view>

  <view class="home-section home-section--last">
    <view class="home-section__header">
      <text class="home-section__title">More updates</text>
      <text class="home-section__meta">A broader queue for inspiration, drafts and saved assets</text>
    </view>
    <view class="home-grid">
      <card wx:for="{{cardInfo}}" wx:key="index" desc="{{item.desc}}" url="{{item.url}}" tags="{{item.tags}}" />
    </view>
  </view>
</scroll-view>

<view class="home-release" bindtap="goRelease">
  <t-icon name="edit-1" size="36rpx" />
  <text>Compose</text>
</view>
<t-message id="t-message" />