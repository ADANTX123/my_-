<t-toast id="t-toast" />

<view class="account-page">
  <nav title-text="Account" />

  <view class="account-card">
    <view class="account-card__top" wx:if="{{isLoad}}">
      <t-avatar image="{{personalInfo.image}}" size="88rpx" />
      <view class="account-card__copy">
        <text class="account-card__name">{{personalInfo.name}}</text>
        <text class="account-card__email">{{accountInfo.email}}</text>
        <text class="account-card__plan">{{accountInfo.plan}}</text>
      </view>
      <t-icon name="edit" size="40rpx" color="#1f1f1f" bindtap="onNavigateTo" />
    </view>

    <view class="account-card__top" wx:if="{{!isLoad}}" bindtap="onLogin">
      <t-avatar icon="user" size="88rpx" />
      <view class="account-card__copy">
        <text class="account-card__name">Sign in to Gmail-style workspace</text>
        <text class="account-card__email">Use your account to sync mail, drafts and profile data.</text>
      </view>
    </view>

    <view class="account-storage">
      <text class="account-storage__label">Storage</text>
      <text class="account-storage__value">{{accountInfo.storage}}</text>
    </view>
  </view>

  <view class="account-section">
    <view class="account-section__title">Mailbox shortcuts</view>
    <t-grid t-class="grid-class">
      <t-grid-item
        wx:for="{{gridList}}"
        wx:for-item="gridItem"
        wx:key="type"
        text="{{gridItem.name}}"
        icon="{{gridItem.icon}}"
        class="grid-item"
        data-data="{{gridItem}}"
        bindclick="onEleClick"
      />
    </t-grid>
  </view>

  <view class="account-section">
    <view class="account-section__title">Workspace apps</view>
    <t-grid column="{{4}}" class="account-service__list">
      <t-grid-item
        class="account-service__list-item"
        wx:for="{{service}}"
        wx:key="item"
        text="{{item.name}}"
        image="{{item.image}}"
        url="{{item.url}}"
        data-data="{{item}}"
        bindclick="onEleClick"
      />
    </t-grid>
  </view>

  <t-cell-group theme="card">
    <t-cell
      wx:for="{{settingList}}"
      wx:for-item="item"
      wx:key="type"
      title="{{item.name}}"
      url="{{item.url}}"
      leftIcon="{{item.icon}}"
      hover
      arrow
      data-data="{{item}}"
      bindclick="onEleClick"
    />
  </t-cell-group>
</view>